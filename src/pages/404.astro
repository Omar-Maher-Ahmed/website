---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/paths';
---

<BaseLayout title="404 - Page Not Found | LimeDev" description="The page you are looking for does not exist.">
  <div class="error-container">
    <div class="error-card glass-panel">
      <div class="error-code">404</div>
      <h1 class="error-title" data-i18n="pageNotFound">الصفحة غير موجودة</h1>
      <p class="error-desc" data-i18n="pageNotFoundDesc">عذراً، لم نتمكن من العثور على الصفحة التي تبحث عنها. ربما تم نقلها أو حذفها.</p>
      
      <div class="error-actions">
        <a href={getPath('/')} class="primary-btn">
          <span data-i18n="backHome">العودة للرئيسية</span>
        </a>
        <a href={getPath('/articles')} class="secondary-btn">
          <span data-i18n="exploreArticles">استكشف المقالات</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  // Smart redirect for GitHub Pages without the base path
  (function() {
    // If we're on a GitHub Pages site and the URL is missing the base path
    const repoName = '/website';
    const currentPath = window.location.pathname;
    const hostname = window.location.hostname;
    
    // Only redirect if on github.io and path doesn't start with repoName
    if (hostname.includes('github.io') && !currentPath.startsWith(repoName)) {
      // Avoid infinite redirects if it's already the root 404 page for the user site
      if (currentPath !== '/') {
        window.location.href = repoName + currentPath + window.location.search + window.location.hash;
      }
    }
  })();
</script>

<style>
  .error-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding: var(--space-8) 0;
  }
  
  .error-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-8);
    max-width: 600px;
    width: 100%;
  }
  
  .error-code {
    font-family: var(--font-mono);
    font-size: 6rem;
    font-weight: 700;
    line-height: 1;
    color: var(--accent-cyan);
    margin-bottom: var(--space-4);
    text-shadow: var(--glass-glow);
  }
  
  .error-title {
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: var(--space-4);
  }
  
  .error-desc {
    color: var(--text-secondary);
    font-size: 1.125rem;
    margin-bottom: var(--space-8);
    max-width: 400px;
  }
  
  .error-actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
  }
  
  .secondary-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--glass-4-bg);
    border: 1px solid var(--glass-4-border);
    color: var(--text-primary);
    padding: 0 var(--space-6);
    height: 48px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  
  .secondary-btn:hover {
    background: var(--glass-card-hover-bg);
    border-color: var(--accent-cyan-dim);
    color: var(--accent-cyan);
  }
  
  .primary-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--primary-btn-bg);
    border: 1px solid var(--primary-btn-border);
    color: var(--primary-btn-text) !important;
    padding: 0 var(--space-6);
    height: 48px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: var(--primary-btn-shadow);
  }
  
  .primary-btn:hover {
    background: var(--primary-btn-hover-bg);
    border-color: var(--accent-cyan);
    color: var(--primary-btn-text) !important;
    box-shadow: var(--glass-glow), var(--primary-btn-shadow);
    transform: translateY(-1px);
  }
</style>
