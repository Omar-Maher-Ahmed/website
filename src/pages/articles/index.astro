---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles');
const sortedArticles = allArticles.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<BaseLayout title="Technical Archive | LimeDev" description="Complete index of all technical writeups, security analyses, and tutorials.">
  <div class="archive-container">
    <header class="title-space">
      <h1 class="main-title" data-i18n="archiveIndex">الفهرس</h1>
      <h2 class="sub-title" data-i18n="allEntries">جميع المقالات والشروحات التقنية</h2>
    </header>
    
    <div class="archive-grid">
      {sortedArticles.map((article, index) => {
        const articleNum = article.data.articleNumber?.toString().padStart(3, '0') || (sortedArticles.length - index).toString().padStart(3, '0');
        
        return (
          <a href={`/articles/${article.id}`} class="glass-floating archive-card">
            <div class="card-header">
              <span class="card-cat">{article.data.category}</span>
              <span class="card-num">#{articleNum}</span>
            </div>
            
            <h2 class="card-title">{article.data.title}</h2>
            <p class="card-desc">{article.data.description}</p>
            
            <div class="card-footer">
              <span class="card-date">{new Date(article.data.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }).toUpperCase()}</span>
              <span class="read-more" data-i18n="readMore">اقرأ المزيد ←</span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</BaseLayout>

<style>
  .archive-container {
    max-width: 1000px;
    margin: 0 auto;
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }
  
  .title-space {
    margin-bottom: var(--space-10);
  }
  
  .main-title {
    font-family: var(--font-display);
    font-size: 3.25rem;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: var(--space-2);
    line-height: 1.1;
  }
  
  .sub-title {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    color: var(--text-secondary);
    text-transform: uppercase;
  }
  
  .archive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  
  .archive-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    transition: all var(--transition-normal);
    text-decoration: none;
    height: 100%;
  }
  
  .archive-card:hover {
    transform: translateY(-4px);
    border-color: var(--glass-card-hover-border);
    box-shadow: var(--glass-card-hover-shadow);
    background: var(--glass-card-hover-bg);
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }
  
  .card-cat {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }
  
  .card-num {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }
  
  .card-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: var(--space-3);
    line-height: 1.25;
    transition: color var(--transition-fast);
  }
  
  .archive-card:hover .card-title {
    color: var(--accent-cyan);
  }
  
  .card-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-6);
    flex: 1;
    line-height: 1.5;
  }
  
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--glass-border-subtle);
    padding-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  
  .card-date {
    color: var(--text-muted);
  }
  
  .read-more {
    color: var(--accent-cyan);
    font-weight: 600;
    transition: transform var(--transition-fast);
  }
  
  .archive-card:hover .read-more {
    transform: translateX(3px);
  }
  
  @media (max-width: 768px) {
    .archive-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
