---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);

const formattedDate = new Date(article.data.publishedAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
}).toUpperCase();

const articleNum = article.data.articleNumber?.toString().padStart(3, '0') || '001';
---

<BaseLayout title={`${article.data.title} | LimeDev`} description={article.data.description}>
  <div class="article-spatial-layout">
    
    <article class="glass-article">
      <header class="article-header">
        <div class="header-top">
          <div class="header-meta">
            <span class="category-badge">#{articleNum}</span>
            <span class="category-text">{article.data.category.toUpperCase()} / ARCHIVE</span>
          </div>
        </div>
        
        <div class="title-block">
          <h1 class="title" data-i18n="article1Title">{article.data.titleAr || article.data.title}</h1>
        </div>
        
        <p class="description" data-i18n="article1Desc">{article.data.descriptionAr || article.data.description}</p>
        
        <div class="tags-list inline">
          {article.data.tags.map((tag: string) => (
            <span class="tag-glass">{tag}</span>
          ))}
        </div>
        
        <div class="hero-actions">
          {article.data.youtubeUrl && (
            <a href={article.data.youtubeUrl} class="primary-btn" target="_blank" rel="noopener noreferrer">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span data-i18n="watchOnYoutube">شاهد على يوتيوب</span>
              <svg class="external-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
            </a>
          )}
        </div>
        
        <div class="header-footer">
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            <time datetime={article.data.publishedAt.toString()}>{formattedDate}</time>
          </div>
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            <span data-i18n="readTime">قراءة 8 دقائق</span>
          </div>
          <div class="meta-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
            <span>LimeDev</span>
          </div>
        </div>
      </header>
      
      <div class="article-content">
        <Content />
      </div>
    </article>
    
    <aside class="right-context-panel">
      {headings && headings.length > 0 && (
        <div class="context-card">
          <div class="card-header">
            <span data-i18n="onThisPage">في هذه الصفحة</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          </div>
          <ul class="toc-list">
            {headings.filter(h => h.depth <= 2).map((h, i) => (
              <li>
                <a href={`#${h.slug}`} class="toc-link">
                  <span class="toc-text">{h.text}</span>
                  <span class="toc-dots"></span>
                  <span class="toc-num">{(i + 1).toString().padStart(2, '0')}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
      
      {((article.data.tools && article.data.tools.length > 0) ? article.data.tools : [
        { name: "Segfault SSH", description: "Remote Security Lab & Host" },
        { name: "LocalXpose", description: "Reverse Tunneling Service" },
        { name: "QR Matrix Generator", description: "URL to 2D Barcode Encoder" }
      ]).length > 0 && (
        <div class="context-card">
          <div class="card-header">
            <div class="card-header-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
              <span data-i18n="toolsUsed">الأدوات المستخدمة</span>
            </div>
          </div>
          <div class="tools-list">
            {((article.data.tools && article.data.tools.length > 0) ? article.data.tools : [
              { name: "Segfault SSH", description: "Remote Security Lab & Host" },
              { name: "LocalXpose", description: "Reverse Tunneling Service" },
              { name: "QR Matrix Generator", description: "URL to 2D Barcode Encoder" }
            ]).map((tool: any, idx: number) => {
              const icons = ['cyan', 'orange', 'green'];
              const colorClass = icons[idx % icons.length];
              return (
                <div class="tool-item">
                  <div class={`tool-icon ${colorClass}`}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  </div>
                  <div class="tool-info">
                    <span class="tool-name">{tool.name}</span>
                    <span class="tool-desc" {...(tool.i18nDesc ? { 'data-i18n': tool.i18nDesc } : {})}>{tool.description}</span>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
      
      <div class="context-card">
        <div class="card-header">
          <div class="card-header-left">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
            <span data-i18n="popularTags">أبرز الوسوم</span>
          </div>
        </div>
        <div class="tags-list">
          {article.data.tags.map((tag: string) => (
            <span class="tag-glass">{tag}</span>
          ))}
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<style is:global>
  .article-spatial-layout {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }
  
  .glass-article {
    flex: 1;
    min-width: 0;
    background: var(--glass-2-bg);
    backdrop-filter: var(--glass-2-blur);
    -webkit-backdrop-filter: var(--glass-2-blur);
    border: 1px solid var(--glass-2-border);
    box-shadow: var(--glass-2-shadow);
    border-radius: var(--radius-xl);
    padding: var(--space-10) var(--space-12);
    position: relative;
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }
  
  /* Glowing radial gradient backdrop */
  .glass-article::before {
    content: '';
    position: absolute;
    top: 15%;
    right: 10%;
    width: 320px;
    height: 320px;
    background: radial-gradient(circle, var(--ambient-cyan) 0%, transparent 70%);
    pointer-events: none;
    z-index: -1;
  }
  
  .right-context-panel {
    width: 320px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }
  
  .article-header {
    margin-bottom: var(--space-8);
  }
  
  .header-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-6);
  }
  
  .header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  
  .category-badge {
    background: var(--accent-cyan-dim);
    color: var(--accent-cyan);
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
  }
  
  .category-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    font-weight: 500;
  }

  
  .title-block {
    margin-bottom: var(--space-4);
  }
  
  .title {
    font-family: var(--font-serif);
    font-size: 3.25rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  
  .description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: 1.6;
    max-width: 650px;
  }
  
  .tags-list.inline {
    margin-bottom: var(--space-6);
  }
  
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }
  
  .primary-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--primary-btn-bg);
    border: 1px solid var(--primary-btn-border);
    color: var(--primary-btn-text) !important;
    padding: 0 var(--space-6);
    height: 48px;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: all var(--transition-fast);
    box-shadow: var(--primary-btn-shadow);
  }
  
  .primary-btn:hover {
    background: var(--primary-btn-hover-bg);
    border-color: var(--accent-cyan);
    color: var(--primary-btn-text) !important;
    box-shadow: var(--glass-glow), var(--primary-btn-shadow);
    transform: translateY(-1px);
  }
  
  .primary-btn svg:not(.external-icon) {
    color: #ffffff;
    fill: rgba(255, 255, 255, 0.25);
  }
  
  .primary-btn .external-icon {
    color: rgba(255, 255, 255, 0.8);
    margin-left: var(--space-1);
  }
  
  .header-footer {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    border-top: 1px solid var(--glass-border-subtle);
    padding-top: var(--space-6);
  }
  
  .meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    background: var(--glass-3-bg);
    backdrop-filter: var(--glass-3-blur);
    -webkit-backdrop-filter: var(--glass-3-blur);
    border: 1px solid var(--glass-3-border);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-full);
    color: var(--text-secondary);
    font-size: 0.8125rem;
    transition: all var(--transition-fast);
  }
  
  .meta-item svg {
    color: var(--text-muted);
  }
  
  /* Context Cards */
  .context-card {
    background: var(--glass-3-bg);
    backdrop-filter: var(--glass-3-blur);
    -webkit-backdrop-filter: var(--glass-3-blur);
    border: 1px solid var(--glass-3-border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    box-shadow: var(--glass-3-shadow);
    transition: background-color var(--transition-normal), border-color var(--transition-normal);
  }
  
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0.05em;
    margin-bottom: var(--space-4);
  }
  
  .card-header-left {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  
  .card-header svg {
    color: var(--text-muted);
  }
  
  .toc-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  
  .toc-link {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: 0.875rem;
    color: var(--text-secondary);
    padding: 3px 0;
    transition: color var(--transition-fast);
    text-decoration: none;
  }
  
  .toc-link:hover {
    color: var(--accent-cyan);
  }
  
  .toc-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  .toc-dots {
    flex-grow: 1;
    border-bottom: 1px dotted var(--toc-dot-color);
    margin: 0 var(--space-2);
    position: relative;
    top: -3px;
    min-width: 12px;
  }
  
  .toc-num {
    font-family: var(--font-mono);
    color: var(--text-muted);
    font-size: 0.75rem;
    flex-shrink: 0;
  }
  
  .tools-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  
  .tool-item {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  
  .tool-icon {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  
  .tool-icon.orange { background: rgba(249, 115, 22, 0.15); color: #F97316; }
  .tool-icon.dark { background: var(--icon-btn-bg); color: var(--text-primary); border: 1px solid var(--glass-border-subtle); }
  .tool-icon.green { background: rgba(34, 197, 94, 0.15); color: #16A34A; }
  
  .tool-info {
    display: flex;
    flex-direction: column;
  }
  
  .tool-name {
    font-size: 0.875rem;
    color: var(--text-primary);
    font-weight: 500;
  }
  
  .tool-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  
  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  
  .tag-glass {
    font-size: 0.8125rem;
    background: var(--tag-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--tag-border);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    color: var(--tag-text);
    transition: all var(--transition-fast);
  }
  
  .tag-glass:hover {
    color: var(--tag-hover-text);
    background: var(--tag-hover-bg);
    border-color: var(--tag-hover-border);
  }
  
  /* Article Content Styles */
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--text-primary);
  }
  
  .article-content h2,
  .article-content h3,
  .article-content h4 {
    font-family: var(--font-serif);
    color: var(--text-primary);
    margin-top: var(--space-10);
    margin-bottom: var(--space-4);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  
  .article-content h2 {
    font-size: 1.875rem;
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--glass-border-subtle);
  }
  
  .article-content h3 {
    font-size: 1.375rem;
  }
  
  .article-content p {
    margin-bottom: var(--space-6);
    color: var(--text-secondary);
  }
  
  .article-content strong {
    color: var(--text-primary);
    font-weight: 600;
  }
  
  .article-content a {
    color: var(--accent-cyan);
    text-decoration: underline;
    text-decoration-color: var(--accent-cyan-dim);
    text-underline-offset: 4px;
    transition: color var(--transition-fast);
  }
  
  .article-content a:hover {
    color: var(--accent-cyan);
    text-decoration-color: var(--accent-cyan);
  }
  
  .article-content ul,
  .article-content ol {
    margin-bottom: var(--space-6);
    padding-left: var(--space-6);
    color: var(--text-secondary);
  }
  
  .article-content li {
    margin-bottom: var(--space-2);
  }
  
  .article-content code {
    font-family: var(--font-mono);
    background: var(--glass-3-bg);
    border: 1px solid var(--glass-3-border);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    font-size: 0.875em;
    color: var(--accent-cyan);
    font-weight: 500;
  }
  
  /* Syntax Highlighting & Code Blocks */
  .article-content pre {
    border: 1px solid var(--cmd-screen-border);
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    box-shadow: var(--glass-inner-shadow);
  }
  
  .article-content pre code {
    background: transparent;
    border: none;
    padding: 0;
    font-size: 0.875rem;
    color: inherit;
  }
  
  .article-content blockquote {
    border-left: 3px solid var(--accent-cyan);
    margin: 0 0 var(--space-6) 0;
    color: var(--text-primary);
    background: var(--accent-cyan-dim);
    padding: var(--space-4) var(--space-6);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }
  
  @media (max-width: 992px) {
    .article-spatial-layout {
      flex-direction: column;
    }
    
    .glass-article {
      padding: var(--space-6) var(--space-5);
    }
    
    .title {
      font-size: 2.25rem;
    }
    
    .right-context-panel {
      width: 100%;
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
    }
    
    .context-card {
      flex: 1;
      min-width: 250px;
    }
  }
</style>
