---
---

<button id="lang-toggle" class="lang-toggle-btn" aria-label="Toggle language" title="Switch Language / تغيير اللغة">
  <svg class="globe-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10"></circle>
    <line x1="2" y1="12" x2="22" y2="12"></line>
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
  </svg>
  <span id="lang-indicator" class="lang-text">AR</span>
</button>

<script>
  import { translations } from '../utils/i18n';

  const toggleBtn = document.getElementById('lang-toggle');
  const indicator = document.getElementById('lang-indicator');

  const updatePageLanguage = (lang: 'en' | 'ar') => {
    document.documentElement.setAttribute('data-lang', lang);
    document.documentElement.setAttribute('lang', lang);
    document.documentElement.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');
    
    if (indicator) {
      indicator.textContent = lang === 'ar' ? 'EN' : 'عربي';
    }
    
    localStorage.setItem('site_lang', lang);

    // Update all elements with data-i18n
    const dict = translations[lang] || translations.en;
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n') as keyof typeof dict;
      if (key && dict[key] !== undefined) {
        const val = dict[key] as string;
        if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
          (el as HTMLInputElement).placeholder = val;
        } else if (val.includes('<') && val.includes('>')) {
          el.innerHTML = val;
        } else {
          el.textContent = val;
        }
      }
    });

    // Notify any custom listeners
    window.dispatchEvent(new CustomEvent('languagechange', { detail: { lang } }));
  };

  // Initialize from storage or default to Arabic/English
  const savedLang = (localStorage.getItem('site_lang') as 'en' | 'ar') || 'ar';
  updatePageLanguage(savedLang);

  if (toggleBtn) {
    toggleBtn.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-lang') === 'ar' ? 'ar' : 'en';
      const nextLang = current === 'ar' ? 'en' : 'ar';
      updatePageLanguage(nextLang);
    });
  }
</script>

<style>
  .lang-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    height: 38px;
    padding: 0 var(--space-3);
    background: var(--glass-5-bg);
    backdrop-filter: var(--glass-5-blur);
    -webkit-backdrop-filter: var(--glass-5-blur);
    border: 1px solid var(--glass-5-border);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    cursor: pointer;
    transition: all var(--transition-fast);
    box-shadow: var(--glass-highlight-top);
  }

  .lang-toggle-btn:hover {
    background: var(--glass-5-hover);
    border-color: var(--accent-cyan-dim);
    color: var(--accent-cyan);
    transform: translateY(-1px);
    box-shadow: var(--glass-glow), var(--glass-highlight-top);
  }

  .globe-icon {
    color: var(--accent-cyan);
    flex-shrink: 0;
  }

  .lang-text {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }
</style>
