---
import { getCollection } from 'astro:content';
import { getPath } from '../utils/paths';

const allArticles = await getCollection('articles');

// Group by category
const categories = allArticles.reduce((acc, article) => {
  const category = article.data.category || 'Uncategorized';
  if (!acc[category]) {
    acc[category] = [];
  }
  acc[category].push(article);
  return acc;
}, {} as Record<string, typeof allArticles>);

const currentPath = Astro.url.pathname;
---

<aside class="sidebar" id="sidebar">
  <div class="sidebar-header">
    <a href={getPath('/')} class="brand">
      <div class="brand-logo">
        <svg viewBox="0 0 24 24" fill="none" stroke="var(--accent-cyan)" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
      </div>
      <div class="brand-text-container">
        <span class="brand-title">LimeDev</span>
        <span class="brand-subtitle" data-i18n="brandSubtitle">قاعدة المعرفة التقنية</span>
      </div>
    </a>
  </div>
  
  <div class="sidebar-content">
    
    <div class="nav-section">
      <a href={getPath('/articles')} class="section-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        <span data-i18n="archive">الأرشيف</span>
        <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
      
      <div class="categories-list">
        {Object.entries(categories).map(([category, articles], index) => {
          const catNum = (index + 1).toString().padStart(2, '0');
          // Add dummy icons per category for visual match
          const icons = [
            '<path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>', // generic
            '<rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path>', // security
            '<circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1 4-10z"></path>', // networking
            '<polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline>' // programming
          ];
          const icon = icons[index % icons.length];
          
          return (
            <div class="category-group">
              <details class="category-details" open>
                <summary class="category-summary">
                  <div class="cat-title">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" set:html={icon}></svg>
                    <span class="cat-num">{catNum}</span>
                    <span class="cat-name">{category}</span>
                  </div>
                  <svg class="chevron-down" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                </summary>
                <ul class="article-list">
                  {articles.map((article: any) => {
                    const articlePath = getPath(`/articles/${article.id}`);
                    const isActive = currentPath === articlePath || currentPath === `${articlePath}/` || currentPath.startsWith(`${articlePath}/`);
                    
                    return (
                      <li>
                        <a href={articlePath} class={`article-link ${isActive ? 'active' : ''}`}>
                          <div class="link-inner">
                            {isActive && <div class="active-dot"></div>}
                            <span class="link-text">{article.data.title}</span>
                          </div>
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </details>
            </div>
          );
        })}
      </div>
    </div>
    
    <div class="nav-section standalone">
      <a href={getPath('/articles')} class="section-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        <span data-i18n="resources">المصادر</span>
        <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
      <a href={getPath('/articles')} class="section-header">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
        <span data-i18n="resources">المصادر</span>
        <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
      {(() => {
        const toolsPath = getPath('/tools');
        const isToolsActive = currentPath === toolsPath || currentPath === `${toolsPath}/` || currentPath.startsWith(`${toolsPath}/`);
        return (
          <a href={toolsPath} class={`section-header ${isToolsActive ? 'active' : ''}`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path></svg>
            <span data-i18n="tools">الأدوات</span>
            <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        );
      })()}
      {(() => {
        const aboutPath = getPath('/about');
        const isAboutActive = currentPath === aboutPath || currentPath === `${aboutPath}/` || currentPath.startsWith(`${aboutPath}/`);
        return (
          <a href={aboutPath} class={`section-header ${isAboutActive ? 'active' : ''}`}>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
            <span data-i18n="about">عن القناة</span>
            <svg class="chevron" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        );
      })()}
    </div>
  </div>
  
  <div class="sidebar-footer">
    <div class="footer-quote" data-i18n="footerQuote">
      "تعلم. ابنِ. فكك. كرر."
    </div>
    <div class="footer-copy" data-i18n="footerCopy">
      &copy; 2026 LimeDev. جميع الحقوق محفوظة.
    </div>
    <div class="footer-socials">
      <a href="https://youtube.com/@LimeDevhub" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33 2.78 2.78 0 0 0 1.94 2c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>
      </a>
      <a href="https://github.com/LimeDevhub" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
      </a>
    </div>
  </div>
</aside>

<style>
  .sidebar {
    height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--glass-1-bg);
    backdrop-filter: var(--glass-1-blur);
    -webkit-backdrop-filter: var(--glass-1-blur);
    border-right: 1px solid var(--glass-1-border);
    position: relative;
    z-index: 50;
    transition: transform var(--transition-normal), background-color var(--transition-normal), border-color var(--transition-normal);
  }
  
  .sidebar-header {
    padding: var(--space-6);
    border-bottom: 1px solid var(--glass-1-border);
  }
  
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }
  
  .brand-logo {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .brand-text-container {
    display: flex;
    flex-direction: column;
  }
  
  .brand-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.1;
  }
  
  .brand-subtitle {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  
  .sidebar-content {
    flex: 1;
    overflow-y: auto;
    padding: var(--space-4) 0;
  }
  
  .nav-section {
    margin-bottom: var(--space-4);
  }
  
  .section-header {
    display: flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    cursor: pointer;
    background: transparent;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }
  
  .section-header:hover {
    background: var(--glass-hover-bg);
    color: var(--accent-cyan);
  }
  
  .section-header span {
    margin-left: var(--space-3);
    flex: 1;
  }
  
  .section-header .chevron {
    color: var(--text-muted);
    transition: transform var(--transition-fast), color var(--transition-fast);
  }
  
  .section-header:hover .chevron {
    color: var(--accent-cyan);
  }
  
  .standalone .section-header {
    border-radius: var(--radius-md);
    margin: var(--space-2) var(--space-4);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--glass-3-border);
    background: var(--glass-3-bg);
    backdrop-filter: var(--glass-3-blur);
    -webkit-backdrop-filter: var(--glass-3-blur);
    box-shadow: var(--glass-highlight-top);
  }
  
  .standalone .section-header:hover {
    background: var(--glass-4-bg);
    border-color: var(--accent-cyan-dim);
    box-shadow: var(--glass-glow), var(--glass-highlight-top);
  }
  
  .standalone .section-header.active {
    background: var(--accent-cyan-dim);
    border-color: var(--accent-cyan);
    color: var(--accent-cyan);
    box-shadow: var(--glass-glow);
  }
  
  .standalone .section-header.active .chevron {
    color: var(--accent-cyan);
  }
  
  .category-group {
    margin-bottom: var(--space-1);
  }
  
  .category-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2) var(--space-6);
    color: var(--text-secondary);
    font-size: 0.875rem;
    cursor: pointer;
    list-style: none;
    transition: color var(--transition-fast);
  }
  
  .category-summary::-webkit-details-marker {
    display: none;
  }
  
  .category-summary:hover {
    color: var(--text-primary);
  }
  
  .cat-title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  
  .cat-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  
  .cat-name {
    font-weight: 500;
  }
  
  .article-list {
    display: flex;
    flex-direction: column;
    padding: var(--space-1) var(--space-4) var(--space-2) calc(var(--space-6) + 14px);
    position: relative;
  }
  
  .article-list::before {
    content: '';
    position: absolute;
    left: calc(var(--space-6) + 6px);
    top: 0;
    bottom: var(--space-4);
    width: 1px;
    background: var(--divider-color);
  }
  
  .article-link {
    display: block;
    padding: 7px var(--space-3);
    font-size: 0.875rem;
    color: var(--text-muted);
    border-radius: var(--radius-md);
    margin-bottom: 2px;
    position: relative;
    transition: all var(--transition-fast);
  }
  
  .article-link:hover {
    color: var(--text-primary);
    background: var(--glass-hover-bg);
  }
  
  .article-link.active {
    color: var(--text-primary);
    font-weight: 500;
    background: var(--glass-3-bg);
    border: 1px solid var(--glass-3-border);
    box-shadow: var(--glass-3-shadow);
  }
  
  .link-inner {
    display: flex;
    align-items: center;
  }
  
  .active-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent-cyan);
    border-radius: 50%;
    margin-right: var(--space-2);
    box-shadow: 0 0 8px var(--accent-cyan);
  }
  
  .sidebar-footer {
    padding: var(--space-6);
    border-top: 1px solid var(--glass-1-border);
  }
  
  .footer-quote {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-bottom: var(--space-2);
    text-align: center;
  }
  
  .footer-copy {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: center;
    margin-bottom: var(--space-4);
  }
  
  .footer-socials {
    display: flex;
    justify-content: center;
    gap: var(--space-4);
  }
  
  .footer-socials a {
    color: var(--text-muted);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }
  
  .footer-socials a:hover {
    color: var(--accent-cyan);
    transform: translateY(-1px);
  }
  
  @media (max-width: 992px) {
    .sidebar {
      position: fixed;
      left: 0;
      top: 0;
      width: 280px;
      transform: translateX(-100%);
    }
    
    .sidebar.open {
      transform: translateX(0);
      box-shadow: 10px 0 30px rgba(0,0,0,0.25);
    }
  }
</style>
